{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "USE_BUILTIN_RIPGREP": "0",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.config/claude/mods/clock:~/.config/claude/mods/nv"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read",
      "Edit",
      "Write",
      "Skill",
      "mcp__claude-mux__*",
      "mcp__claude_ai_Craft__*",
      "mcp__claude_ai_Gmail__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__cloudflare-bindings__*",
      "mcp__cloudflare-docs__*",
      "mcp__cloudflare-graphql__*",
      "mcp__cloudflare-observability__*",
      "mcp__craft__*",
      "mcp__plugin_engram_engram__*",
      "mcp__plugin_grug-brain_grug-brain__*",
      "mcp__plugin_herderp_derp__*",
      "mcp__plugin_oberskills_skill-eval__*",
      "mcp__plugin_oberskills_mcp-browser__*",
      "mcp__plugin_penman_penman__*",
      "mcp__plugin_sdd_sdd__*",
      "mcp__plugin_stripe_stripe__*",
      "mcp__plugin_upublish_upublish__*",
      "mcp__thegrid__*"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r /* *)",
      "Bash(*rm -rf *)",
      "Bash(*rm -fr *)",
      "Bash(sudo rm *)",
      "Bash(shred *)",
      "Bash(truncate *)",
      "Bash(> *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(fdisk*)",
      "Bash(diskutil erase*)",
      "Bash(diskutil unmount*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push *-f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git clean -x*)",
      "Bash(git checkout -- .)",
      "Bash(git checkout -- */*)",
      "Bash(git restore .)",
      "Bash(git restore --staged .)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git rebase * --exec*)",
      "Bash(kill -9 *)",
      "Bash(killall *)",
      "Bash(sudo kill*)",
      "Bash(pkill -9*)",
      "Bash(pkill *-9 *)",
      "Bash(pkill *-KILL*)",
      "Bash(pkill *-SIGKILL*)",
      "Bash(pkill*-u *)",
      "Bash(pkill*-U *)",
      "Bash(pkill*-G *)",
      "Bash(pkill*-g *)",
      "Bash(pkill*-s *)",
      "Bash(pkill*-t *)",
      "Bash(pkill*-P *)",
      "Bash(pkill .*)",
      "Bash(pkill *claude*)",
      "Bash(pkill *node*)",
      "Bash(pkill *bun*)",
      "Bash(pkill *tmux*)",
      "Bash(pkill *herdr*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(halt*)",
      "Bash(launchctl unload*)",
      "Bash(npm publish*)",
      "Bash(npx npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)",
      "Bash(gem push*)",
      "Bash(cargo publish*)",
      "Bash(pip upload*)",
      "Bash(twine upload*)",
      "Bash(docker rm -f*)",
      "Bash(docker rmi -f*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)",
      "Bash(docker container prune*)",
      "Bash(docker image prune*)",
      "Bash(kubectl delete *)",
      "Bash(kubectl drain *)",
      "Bash(kubectl cordon *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(chown *)",
      "Bash(sudo chown *)",
      "Bash(sudo chmod *)",
      "Bash(dropdb *)",
      "Bash(* DROP DATABASE *)",
      "Bash(* DROP TABLE *)",
      "Bash(* drop database *)",
      "Bash(* drop table *)",
      "Bash(redis-cli FLUSHALL*)",
      "Bash(redis-cli FLUSHDB*)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(launchctl bootout*)",
      "Bash(launchctl bootstrap*)",
      "Bash(pkill *)",
      "Bash(pkill -f*)",
      "Bash(pkill -*f *)",
      "Bash(pkill --full*)",
      "Bash(pkill *--full *)"
    ]
  },
  "extraKnownMarketplaces": {
    "upublish.skill": {
      "source": {
        "source": "github",
        "repo": "omni-ping/upublish.skill"
      }
    },
    "rtd": {
      "source": {
        "source": "github",
        "repo": "ryanthedev/rtd-claude-inn"
      }
    }
  },
  "outputStyle": "Skimmable",
  "statusLine": {
    "type": "command",
    "command": "~/.config/claude/statusline.sh"
  },
  "theme": "dark",
  "editorMode": "vim",
  "tui": "fullscreen",
  "alwaysThinkingEnabled": true,
  "autoCompactEnabled": false,
  "autoMemoryEnabled": false
}
