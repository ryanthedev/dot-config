{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "USE_BUILTIN_RIPGREP": "0",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read",
      "Edit",
      "Write",
      "Bash(*)",
      "mcp__grug-brain__*",
      "mcp__plugin_grug-brain_grug-brain__*",
      "mcp__plugin_engram_engram__*",
      "mcp__claude-mux__*",
      "mcp__thegrid__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__plugin_penman_penman__*",
      "mcp__plugin_stripe_stripe__*",
      "mcp__plugin_oberskills_skill-eval__*",
      "mcp__plugin_oberskills_mcp-browser__*",
      "mcp__craft__*",
      "mcp__plugin_upublish_upublish__*",
      "mcp__plugin_claude-mux_tmux__*",
      "mcp__plugin_ado_ado__*",
      "mcp__plugin_sabre_sabre__*",
      "mcp__plugin_sumo_sumo__*",
      "mcp__tmux__*"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r /* *)",
      "Bash(*rm -rf *)",
      "Bash(*rm -fr *)",
      "Bash(sudo rm *)",
      "Bash(shred *)",
      "Bash(truncate *)",
      "Bash(> *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(fdisk*)",
      "Bash(diskutil erase*)",
      "Bash(diskutil unmount*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push *-f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git clean -x*)",
      "Bash(git checkout -- .)",
      "Bash(git checkout -- */*)",
      "Bash(git restore .)",
      "Bash(git restore --staged .)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git rebase * --exec*)",
      "Bash(kill -9 *)",
      "Bash(killall *)",
      "Bash(sudo kill*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(halt*)",
      "Bash(launchctl unload*)",
      "Bash(npm publish*)",
      "Bash(npx npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)",
      "Bash(gem push*)",
      "Bash(cargo publish*)",
      "Bash(pip upload*)",
      "Bash(twine upload*)",
      "Bash(docker rm -f*)",
      "Bash(docker rmi -f*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)",
      "Bash(docker container prune*)",
      "Bash(docker image prune*)",
      "Bash(kubectl delete *)",
      "Bash(kubectl drain *)",
      "Bash(kubectl cordon *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(chown *)",
      "Bash(sudo chown *)",
      "Bash(sudo chmod *)",
      "Bash(dropdb *)",
      "Bash(* DROP DATABASE *)",
      "Bash(* DROP TABLE *)",
      "Bash(* drop database *)",
      "Bash(* drop table *)",
      "Bash(redis-cli FLUSHALL*)",
      "Bash(redis-cli FLUSHDB*)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(launchctl bootout*)",
      "Bash(launchctl bootstrap*)",
      "Bash(pkill *)"
    ]
  },
  "model": "claude-opus-4-8[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ast-grep@ast-grep-marketplace": true,
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "svelte-foundations@/Users/r/repos/svelte-foundations.skill": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "upublish@upublish.skill": true
  },
  "extraKnownMarketplaces": {
    "upublish.skill": {
      "source": {
        "source": "github",
        "repo": "omni-ping/upublish.skill"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "autoCompactEnabled": false,
  "feedbackSurveyState": {
    "lastShownTime": 1754078816059
  },
  "statusLine": {
    "type": "command",
    "command": "~/.config/claude/statusline.sh"
  }
}
