{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "USE_BUILTIN_RIPGREP": "0",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read",
      "Edit",
      "Write",
      "Bash(*)",
      "mcp__grug-brain__*",
      "mcp__plugin_grug-brain_grug-brain__*",
      "mcp__claude-mux__*",
      "mcp__plugin_claude-mux_tmux__*",
      "mcp__plugin_penman_penman__*",
      "mcp__jjira__*",
      "mcp__plugin_janky-jira_jjira__*",
      "mcp__plugin_herderp_derp__*",
      "mcp__plugin_oberskills_mcp-browser__*",
      "mcp__plugin_oberskills_skill-eval__*",
      "mcp__claude_ai_Carvana_Fastlane__*"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r /* *)",
      "Bash(*rm -rf *)",
      "Bash(*rm -fr *)",
      "Bash(sudo rm *)",
      "Bash(shred *)",
      "Bash(truncate *)",
      "Bash(> *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(fdisk*)",
      "Bash(diskutil erase*)",
      "Bash(diskutil unmount*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push *-f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git clean -x*)",
      "Bash(git checkout -- .)",
      "Bash(git checkout -- */*)",
      "Bash(git restore .)",
      "Bash(git restore --staged .)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git rebase * --exec*)",
      "Bash(kill -9 *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(sudo kill*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(halt*)",
      "Bash(launchctl unload*)",
      "Bash(launchctl bootout*)",
      "Bash(npm publish*)",
      "Bash(npx npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)",
      "Bash(gem push*)",
      "Bash(cargo publish*)",
      "Bash(pip upload*)",
      "Bash(twine upload*)",
      "Bash(docker rm -f*)",
      "Bash(docker rmi -f*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)",
      "Bash(docker container prune*)",
      "Bash(docker image prune*)",
      "Bash(kubectl delete *)",
      "Bash(kubectl drain *)",
      "Bash(kubectl cordon *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(chown *)",
      "Bash(sudo chown *)",
      "Bash(sudo chmod *)",
      "Bash(dropdb *)",
      "Bash(* DROP DATABASE *)",
      "Bash(* DROP TABLE *)",
      "Bash(* drop database *)",
      "Bash(* drop table *)",
      "Bash(redis-cli FLUSHALL*)",
      "Bash(redis-cli FLUSHDB*)",
      "Bash(rsync * *:*)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(launchctl bootout*)",
      "Bash(launchctl bootstrap*)",
      "Bash(pkill *)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "tmux set-option -pu @claude-waiting 2>/dev/null; true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "tmux set-option -p @claude-waiting 1 2>/dev/null; true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.config/claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-mux@rtd": true,
    "code-foundations@rtd": true,
    "design-for-ai@rtd": true,
    "frontend-design@claude-plugins-official": true,
    "grug-brain@rtd": true,
    "herderp@rtd": true,
    "oberskills@rtd": true,
    "penman@rtd": true,
    "pyright-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "what@rtd": true,
    "janky-jira@janky-jira-local": true,
    "ephemeral-environment@carvana-claude-code-marketplace": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "rtd": {
      "source": {
        "source": "github",
        "repo": "ryanthedev/rtd-claude-inn"
      }
    },
    "upublish.skill": {
      "source": {
        "source": "github",
        "repo": "omni-ping/upublish.skill"
      }
    },
    "janky-jira-local": {
      "source": {
        "source": "github",
        "repo": "CVNA-DEVOPS-PRIVATE/janky-jira"
      }
    },
    "carvana-claude-code-marketplace": {
      "source": {
        "source": "git",
        "url": "git@github.com:CVNA-Pathfinders/Carvana-Claude-Marketplace.git"
      }
    }
  },
  "outputStyle": "Terse",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "low"
    },
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": false,
  "feedbackSurveyState": {
    "lastShownTime": 1754078816059
  }
}
